\"      \x3Ctd>Street Parade\x3C/td>\\n\",","       \"      \x3Ctd>2025-08-09\x3C/td>\\n\",","       \"      \x3Ctd>2025-08-09\x3C/td>\\n\",","       \"      \x3Ctd>1\x3C/td>\\n\",","       \"      \x3Ctd>800000\x3C/td>\\n\",","       \"    \x3C/tr>\\n\",","       \"  \x3C/tbody>\\n\",","       \"\x3C/table>\\n\",","       \"\x3C/div>\"","      ],","      \"text/plain\": [","       \"  event_id     event_name event_start_date event_end_date  \\\\\\n\",","       \"0  ZF_2019    Züri Fäscht       2019-07-05     2019-07-07   \\n\",","       \"1  SP_2019  Street Parade       2019-08-10     2019-08-10   \\n\",","       \"2  SP_2022  Street Parade       2022-08-13     2022-08-13   \\n\",","       \"3  ZF_2023    Züri Fäscht       2023-07-07     2023-07-09   \\n\",","       \"4  SP_2023  Street Parade       2023-08-12     2023-08-12   \\n\",","       \"5  SP_2024  Street Parade       2024-08-10     2024-08-10   \\n\",","       \"6  SP_2025  Street Parade       2025-08-09     2025-08-09   \\n\",","       \"\\n\",","       \"   event_duration_days  edition_attendance  \\n\",","       \"0                    3             2500000  \\n\",","       \"1                    1              850000  \\n\",","       \"2                    1              900000  \\n\",","       \"3                    3             2000000  \\n\",","       \"4                    1              920000  \\n\",","       \"5                    1              920000  \\n\",","       \"6                    1              800000  \"","      ]","     },","     \"execution_count\": 2,","     \"metadata\": {},","     \"output_type\": \"execute_result\"","    }","   ],","   \"source\": [","    \"spending = pd.read_csv(SPENDING_FILE, parse_dates=[\\\"date\\\"], encoding=\\\"utf-8-sig\\\")\\n\",","    \"editions = pd.read_csv(EDITIONS_FILE, encoding=\\\"utf-8-sig\\\",\\n\",","    \"                       parse_dates=[\\\"event_start_date\\\", \\\"event_end_date\\\", \\\"event_reference_date\\\"])\\n\",","    \"integrated = pd.read_csv(INTEGRATED_FILE, parse_dates=[\\\"date\\\"], encoding=\\\"utf-8-sig\\\")\\n\",","    \"\\n\",","    \"assert spending.shape == (7671, 5), spending.shape\\n\",","    \"assert editions.shape == (7, 10), editions.shape\\n\",","    \"assert integrated.shape == (1197, 7), integrated.shape          # 7 editions x 57 days x 3 categories\\n\",","    \"assert spending.notna().all().all() and integrated.notna().all().all(), \\\"missing values in the input data\\\"\\n\",","    \"assert not spending.duplicated([\\\"date\\\", \\\"merchant_category\\\"]).any(), \\\"duplicate spending rows\\\"\\n\",","    \"assert not integrated.duplicated([\\\"event_id\\\", \\\"date\\\", \\\"merchant_category\\\"]).any(), \\\"duplicate window rows\\\"\\n\",","    \"\\n\",","    \"event_days = integrated.loc[integrated[\\\"is_event_day\\\"], [\\\"event_id\\\", \\\"date\\\"]].drop_duplicates()\\n\",","    \"assert integrated[\\\"event_id\\\"].nunique() == 7 and len(event_days) == 11\\n\",","    \"\\n\",","    \"print(\\\"Spending:\\\", spending.shape, \\\"| Editions:\\\", editions.shape, \\\"| Integrated:\\\", integrated.shape,\\n\",","    \"      \\\"| Event days:\\\", len(event_days))\\n\",","    \"editions[[\\\"event_id\\\", \\\"event_name\\\", \\\"event_start_date\\\", \\\"event_end_date\\\", \\\"event_duration_days\\\", \\\"edition_attendance\\\"]]\"","   ]","  },","  {","   \"cell_type\": \"markdown\",","   \"id\": \"0856f95e\",","   \"metadata\": {},","   \"source\": [","    \"## 4. Baselines and percentage deviations\\n\",","    \"\\n\",","    \"Baselines are calculated using the median of eligible same-weekday observations within the ±28-day event window. For every edition, category and day:\\n\",","    \"* **Same window:** control dates lie within ±28 days of the edition's day 0, so the comparison stays in the same year and season.\\n\",","    \"* **Same weekday:** a Saturday is compared only with other Saturdays.\\n\",","    \"* **Excluded from the control dates:**\\n\",","    \"  * the target observation itself,\\n\",","    \"  * the 11 recorded Street Parade and Züri Fäscht dates, including those of other editions,\\n\",","    \"  * two public holidays: 1 August (Swiss National Day) and Whit Monday (Easter Sunday + 50 days).\\n\",","    \"* **Not excluded:** other events, such as Zürich Openair, Caliente!, Coldplay or Zürcher Theater Spektakel, and school holidays. The holiday list is not a complete calendar.\\n\",","    \"* **At least three controls,** otherwise the baseline is left empty.\\n\",","    \"\\n\",","    \"The median is used because it is less affected by single unusual days than the mean. Control days come from the full spending file, each date once per edition and category, so overlapping windows cannot count a day twice.\\n\",","    \"\\n\",","    \"The same baseline is calculated separately for the number of transactions (`scaled_n_transactions`), using the same control days. The deviation is\\n\",","    \"\\n\",","    \"`percentage deviation = 100 × (value − baseline) / baseline`\\n\",","    \"\\n\",","    \"Positive values mean more spending (or transactions) than on comparable days. Both measures are scaled MCS values, not CHF amounts or real transaction counts.\"","   ]","  },","  {","   \"cell_type\": \"code\",","   \"execution_count\": 3,","   \"id\": \"88f0e5e7\",","   \"metadata\": {","    \"execution\": {","     \"iopub.execute_input\": \"2026-11-01T16:44:09.176643Z\",","     \"iopub.status.busy\": \"2026-11-01T16:44:09.175949Z\",","     \"iopub.status.idle\": \"2026-11-01T16:44:09.197264Z\",","     \"shell.execute_reply\": \"2026-11-01T16:44:09.196389Z\"","    }","   },","   \"outputs\": [","    {","     \"name\": \"stdout\",","     \"output_type\": \"stream\",","     \"text\": [","      \"2019: Whit Monday 2019-06-10\\n\",","      \"2022: Whit Monday 2022-06-06\\n\",","      \"2023: Whit Monday 2023-05-29\\n\",","      \"2024: Whit Monday 2024-05-20\\n\",","      \"2025: Whit Monday 2025-06-09\\n\",","      \"Excluded holidays inside an event window: [datetime.date(2019, 6, 10), datetime.date(2019, 8, 1), datetime.date(2022, 8, 1), datetime.date(2023, 8, 1), datetime.date(2024, 8, 1), datetime.date(2025, 8, 1)]\\n\"","     ]","    }","   ],","   \"source\": [","    \"# dates that must not be used as controls: all event days and the two public holidays inside the windows\\n\",","    \"all_event_dates = set(event_days[\\\"date\\\"])\\n\",","    \"holiday_dates = set()\\n\",","    \"for year in sorted(editions[\\\"event_year\\\"].unique()):\\n\",","    \"    whit_monday = pd.Timestamp(easter(year)) + pd.Timedelta(days=50)\\n\",","    \"    assert whit_monday.day_name() == \\\"Monday\\\"\\n\",","    \"    holiday_dates.add(pd.Timestamp(year, 8, 1))      # Swiss National Day\\n\",","    \"    holiday_dates.add(whit_monday)\\n\",","    \"    print(f\\\"{year}: Whit Monday {whit_monday.date()}\\\")\\n\",","    \"\\n\",","    \"print(\\\"Excluded holidays inside an event window:\\\",\\n\",","    \"      sorted(d.date() for d in holiday_dates if d in set(integrated[\\\"date\\\"])))\\n\",","    \"\\n\",","    \"spending[\\\"weekday\\\"] = spending[\\\"date\\\"].dt.day_name()\\n\",","    \"integrated[\\\"weekday\\\"] = integrated[\\\"date\\\"].dt.day_name()\"","   ]","  },","  {","   \"cell_type\": \"code\",","   \"execution_count\": 4,","   \"id\": \"7ee50ae1\",","   \"metadata\": {","    \"execution\": {","     \"iopub.execute_input\": \"2026-11-01T16:44:09.199385Z\",","     \"iopub.status.busy\": \"2026-11-01T16:44:09.198691Z\",","     \"iopub.status.idle\": \"2026-11-01T16:44:09.204522Z\",","     \"shell.execute_reply\": \"2026-11-01T16:44:09.203670Z\"","    }","   },","   \"outputs\": [],","   \"source\": [","    \"def calculate_baselines(value_column=\\\"scaled_value\\\", max_distance=28, exclude_month_end=False):\\n\",","    \"    \\\"\\\"\\\"Median of same-weekday control days for every day of every event window.\\n\",","    \"\\n\",","    \"    max_distance and exclude_month_end are only changed for the sensitivity checks in section 7.\\n\",","    \"    \\\"\\\"\\\"\\n\",","    \"    rows = []\\n\",","    \"    for (event_id, category), window in integrated.groupby([\\\"event_id\\\", \\\"merchant_category\\\"]):\\n\",","    \"        # possible control days: this window's dates, without event days and holidays\\n\",","    \"        window_dates = window.loc[window[\\\"relative_day\\\"].abs() \x3C= max_distance, \\\"date\\\"]\\n\",","    \"        pool = spending[(spending[\\\"merchant_category\\\"] == category) & spending[\\\"date\\\"].isin(window_dates)]\\n\",","    \"        pool = pool[~pool[\\\"date\\\"].isin(all_event_dates) & ~pool[\\\"date\\\"].isin(holiday_dates)]\\n\",","    \"        if exclude_month_end:\\n\",","    \"            pool = pool[pool[\\\"date\\\"].dt.day \x3C 25]\\n\",","    \"\\n\",","    \"        for _, day in window.iterrows():\\n\",","    \"            controls = pool[(pool[\\\"weekday\\\"] == day[\\\"weekday\\\"]) & (pool[\\\"date\\\"] != day[\\\"date\\\"])]\\n\",","    \"            rows.append({\\n\",","    \"                \\\"event_id\\\": event_id,\\n\",","    \"                \\\"merchant_category\\\": category,\\n\",","    \"                \\\"date\\\": day[\\\"date\\\"],\\n\",","    \"                \\\"baseline\\\": controls[value_column].median() if len(controls) >= MIN_CONTROLS else np.nan,\\n\",","    \"                \\\"n_controls\\\": len(controls),\\n\",","    \"                \\\"control_dates\\\": list(controls[\\\"date\\\"]),\\n\",","    \"            })\\n\",","    \"    return pd.DataFrame(rows)\"","   ]","  },","  {","   \"cell_type\": \"code\",","   \"execution_count\": 5,","   \"id\": \"47c39950\",","   \"metadata\": {","    \"execution\": {","     \"iopub.execute_input\": \"2026-11-01T16:44:09.206199Z\",","     \"iopub.status.busy\": \"2026-11-01T16:44:09.205990Z\",","     \"iopub.status.idle\": \"2026-11-01T16:44:11.660106Z\",","     \"shell.execute_reply\": \"2026-11-01T16:44:11.659140Z\"","    }","   },","   \"outputs\": [","    {","     \"name\": \"stdout\",","     \"output_type\": \"stream\",","     \"text\": [","      \"Controls per baseline: 6 to 8\\n\"","     ]","    }","   ],","   \"source\": [","    \"keys = [\\\"event_id\\\", \\\"merchant_category\\\", \\\"date\\\"]\\n\",","    \"spending_baselines = calculate_baselines(\\\"scaled_value\\\")\\n\",","    \"transaction_baselines = calculate_baselines(\\\"scaled_n_transactions\\\").rename(columns={\\n\",","    \"    \\\"baseline\\\": \\\"tx_baseline\\\", \\\"n_controls\\\": \\\"tx_n_controls\\\", \\\"control_dates\\\": \\\"tx_control_dates\\\"})\\n\",","    \"\\n\",","    \"results = integrated.merge(spending_baselines, on=keys, validate=\\\"one_to_one\\\")\\n\",","    \"results = results.merge(transaction_baselines, on=keys, validate=\\\"one_to_one\\\")\\n\",","    \"results = results.merge(editions[[\\\"event_id\\\", \\\"event_name\\\", \\\"event_year\\\"]], on=\\\"event_id\\\", validate=\\\"many_to_one\\\")\\n\",","    \"\\n\",","    \"results[\\\"percentage_deviation\\\"] = 100 * (results[\\\"scaled_value\\\"] - results[\\\"baseline\\\"]) / results[\\\"baseline\\\"]\\n\",","    \"results[\\\"tx_percentage_deviation\\\"] = (100 * (results[\\\"scaled_n_transactions\\\"] - results[\\\"tx_baseline\\\"])\\n\",","    \"                                      / results[\\\"tx_baseline\\\"])\\n\",","    \"\\n\",","    \"# checks: no rows lost, every baseline valid, and the control days follow the rules above\\n\",","    \"assert len(results) == 1197\\n\",","    \"assert (results[[\\\"baseline\\\", \\\"tx_baseline\\\"]] > 0).all().all(), \\\"missing or zero baseline\\\"\\n\",","    \"for _, row in results.iterrows():\\n\",","    \"    controls = pd.Series(row[\\\"control_dates\\\"])\\n\",","    \"    assert not controls.isin(all_event_dates | holiday_dates).any(), f\\\"event day or holiday used: {row['date']}\\\"\\n\",","    \"    assert not (controls == row[\\\"date\\\"]).any(), \\\"day used as its own control\\\"\\n\",","    \"    assert (controls.dt.day_name() == row[\\\"weekday\\\"]).all(), \\\"weekday mismatch\\\"\\n\",","    \"    assert row[\\\"control_dates\\\"] == row[\\\"tx_control_dates\\\"], \\\"spending and transactions use different controls\\\"\\n\",","    \"\\n\",","    \"print(\\\"Controls per baseline:\\\", results[\\\"n_controls\\\"].min(), \\\"to\\\", results[\\\"n_controls\\\"].max())\"","   ]","  },","  {","   \"cell_type\": \"markdown\",","   \"id\": \"53dd6e1c\",","   \"metadata\": {},","   \"source\": [","    \"**Worked example.** One deviation recalculated by hand from its control days (Street Parade 2023, Food and beverage services, event day):\"","   ]","  },","  {","   \"cell_type\": \"code\",","   \"execution_count\": 6,","   \"id\": \"d2af9d9e\",","   \"metadata\": {","    \"execution\": {","     \"iopub.execute_input\": \"2026-11-01T16:44:11.662310Z\",","     \"iopub.status.busy\": \"2026-11-01T16:44:11.661708Z\",","     \"iopub.status.idle\": \"2026-11-01T16:44:11.671046Z\",","     \"shell.execute_reply\": \"2026-11-01T16:44:11.670190Z\"","    }","   },","   \"outputs\": [","    {","     \"name\": \"stdout\",","     \"output_type\": \"stream\",","     \"text\": [","      \"Event day: 2023-08-12 Saturday | scaled value: 2.284\\n\",","      \"Control Saturdays: ['2023-07-15', '2023-07-22', '2023-07-29', '2023-08-05', '2023-08-19', '2023-08-26', '2023-09-02', '2023-09-09']\\n\",","      \"Median of controls: 2.3744 | deviation: -3.8%\\n\"","     ]","    }","   ],","   \"source\": [","    \"example = results[(results[\\\"event_id\\\"] == \\\"SP_2023\\\") & (results[\\\"merchant_category\\\"] == \\\"Food and beverage services\\\")\\n\",","    \"                  & results[\\\"is_event_day\\\"]].iloc[0]\\n\",","    \"control_values = spending[(spending[\\\"merchant_category\\\"] == \\\"Food and beverage services\\\")\\n\",","    \"                          & spending[\\\"date\\\"].isin(example[\\\"control_dates\\\"])][\\\"scaled_value\\\"]\\n\",","    \"manual_baseline = control_values.median()\\n\",","    \"manual_deviation = 100 * (example[\\\"scaled_value\\\"] - manual_baseline) / manual_baseline\\n\",","    \"\\n\",","    \"print(\\\"Event day:\\\", example[\\\"date\\\"].date(), example[\\\"weekday\\\"], \\\"| scaled value:\\\", round(example[\\\"scaled_value\\\"], 4))\\n\",","    \"print(\\\"Control Saturdays:\\\", [d.date().isoformat() for d in example[\\\"control_dates\\\"]])\\n\",","    \"print(f\\\"Median of controls: {manual_baseline:.4f} | deviation: {manual_deviation:+.1f}%\\\")\\n\",","    \"assert np.isclose(manual_deviation, example[\\\"percentage_deviation\\\"])\"","   ]","  },","  {","   \"cell_type\": \"markdown\",","   \"id\": \"961625fb\",","   \"metadata\": {},","   \"source\": [","    \"## 5. Event spending and transaction-count figures\\n\",","    \"\\n\",","    \"Each event has one figure with six panels: spending deviations in the top row, transaction-count deviations in the bottom row, and one column per category. Each line is one edition, and each point is one actual day; nothing is averaged or smoothed.\\n\",","    \"* **Axes:** the y-axis is shared within a row but not between rows, because the two measures have different ranges.\\n\",","    \"* **Display window:** the figures show days −14 to +14, while the baselines still use ±28 days.\\n\",","    \"* **Captions:** there are no titles inside the images, so the report can add numbered captions.\\n\",","    \"* **0% line:** this is the baseline, i.e. typical activity on the same weekday, not zero activity.\\n\",","    \"\\n\",","    \"**Street Parade.** One period per category is shown at full opacity, with the rest of the lines faded to 25%:\\n\",","    \"* Accommodation: days −7 to 0,\\n\",","    \"* Transport services: days −1 to +1,\\n\",","    \"* Food and beverage services: days −7 to +1.\\n\",","    \"\\n\",","    \"These are exploratory periods of interest, not confirmed event effects. Swiss National Day (1 August) falls 8–12 days before every edition and is marked with a diamond. The low values on that day coincide with the public holiday and should not be read as Street Parade effects.\\n\",","    \"\\n\",","    \"**Züri Fäscht.** No lines are faded; the grey band marks the three festival days (Friday to Sunday).\\n\",","    \"\\n\",","    \"**Other events.** Other major events close to some editions are marked on the line of their own edition, in both rows. They are only marked, not excluded from the baselines. If two events share a day, their markers are placed slightly side by side; the data points are not moved. Two further events are not marked, to keep the figures readable:\\n\",","    \"* Zürcher Theater Spektakel, from day +5 in every Street Parade window,\\n\",","    \"* Terrazzza Horse Park Festival, 30 June–1 July 2023, the same days as Caliente!.\"","   ]","  },","  {","   \"cell_type\": \"code\",","   \"execution_count\": 7,","   \"id\": \"a61c81af\",","   \"metadata\": {","    \"execution\": {","     \"iopub.execute_input\": \"2026-11-01T16:44:11.672748Z\",","     \"iopub.status.busy\": \"2026-11-01T16:44:11.672516Z\",","     \"iopub.status.idle\": \"2026-11-01T16:44:11.691653Z\",","     \"shell.execute_reply\": \"2026-11-01T16:44:11.690439Z\"","    }","   },","   \"outputs\": [","    {","     \"data\": {","      \"text/html\": [","       \"\x3Cdiv>\\n\",","       \"\x3Cstyle scoped>\\n\",","       \"    .dataframe tbody tr th:only-of-type {\\n\",","       \"        vertical-align: middle;\\n\",","       \"    }\\n\",","       \"\\n\",","       \"    .dataframe tbody tr th {\\n\",","       \"        vertical-align: top;\\n\",","       \"    }\\n\",","       \"\\n\",","       \"    .dataframe thead th {\\n\",","       \"        text-align: right;\\n\",","       \"    }\\n\",","       \"\x3C/style>\\n\",","       \"\x3Ctable border=\\\"1\\\" class=\\\"dataframe\\\">\\n\",","       \"  \x3Cthead>\\n\",","       \"    \x3Ctr style=