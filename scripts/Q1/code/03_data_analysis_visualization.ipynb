               other_event      start        end  first_day  \\\\\\n\",","       \"0  SP_2019                  Zürich Openair 2019-08-21 2019-08-24         11   \\n\",","       \"1  SP_2022                  Zürich Openair 2022-08-23 2022-08-27         10   \\n\",","       \"2  SP_2023                  Zürich Openair 2023-08-22 2023-08-26         10   \\n\",","       \"3  SP_2024                  Zürich Openair 2024-08-23 2024-08-24         13   \\n\",","       \"4  SP_2025                  Zürich Openair 2025-08-22 2025-08-23         13   \\n\",","       \"5  ZF_2019                   Alba Festival 2019-06-29 2019-06-30         -7   \\n\",","       \"6  ZF_2023  Caliente! Latin Music Festival 2023-06-30 2023-07-01         -8   \\n\",","       \"7  ZF_2023           Coldplay (Letzigrund) 2023-07-01 2023-07-02         -7   \\n\",","       \"\\n\",","       \"   last_day marker  \\n\",","       \"0        14      ^  \\n\",","       \"1        14      ^  \\n\",","       \"2        14      ^  \\n\",","       \"3        14      ^  \\n\",","       \"4        14      ^  \\n\",","       \"5        -6      s  \\n\",","       \"6        -7      P  \\n\",","       \"7        -6      *  \"","      ]","     },","     \"execution_count\": 7,","     \"metadata\": {},","     \"output_type\": \"execute_result\"","    }","   ],","   \"source\": [","    \"# other major events close to the editions (dates as researched for the project)\\n\",","    \"other_events = pd.DataFrame([\\n\",","    \"    # main event,      year, other event,                       start,        end,          marker\\n\",","    \"    [\\\"Street Parade\\\", 2019, \\\"Zürich Openair\\\",                  \\\"2019-08-21\\\", \\\"2019-08-24\\\", \\\"^\\\"],\\n\",","    \"    [\\\"Street Parade\\\", 2022, \\\"Zürich Openair\\\",                  \\\"2022-08-23\\\", \\\"2022-08-27\\\", \\\"^\\\"],\\n\",","    \"    [\\\"Street Parade\\\", 2023, \\\"Zürich Openair\\\",                  \\\"2023-08-22\\\", \\\"2023-08-26\\\", \\\"^\\\"],\\n\",","    \"    [\\\"Street Parade\\\", 2024, \\\"Zürich Openair\\\",                  \\\"2024-08-23\\\", \\\"2024-08-24\\\", \\\"^\\\"],\\n\",","    \"    [\\\"Street Parade\\\", 2025, \\\"Zürich Openair\\\",                  \\\"2025-08-22\\\", \\\"2025-08-23\\\", \\\"^\\\"],\\n\",","    \"    [\\\"Züri Fäscht\\\",   2019, \\\"Alba Festival\\\",                   \\\"2019-06-29\\\", \\\"2019-06-30\\\", \\\"s\\\"],\\n\",","    \"    [\\\"Züri Fäscht\\\",   2023, \\\"Caliente! Latin Music Festival\\\",  \\\"2023-06-30\\\", \\\"2023-07-01\\\", \\\"P\\\"],\\n\",","    \"    [\\\"Züri Fäscht\\\",   2023, \\\"Coldplay (Letzigrund)\\\",           \\\"2023-07-01\\\", \\\"2023-07-02\\\", \\\"*\\\"],\\n\",","    \"], columns=[\\\"event_name\\\", \\\"event_year\\\", \\\"other_event\\\", \\\"start\\\", \\\"end\\\", \\\"marker\\\"])\\n\",","    \"other_events[\\\"start\\\"] = pd.to_datetime(other_events[\\\"start\\\"])\\n\",","    \"other_events[\\\"end\\\"] = pd.to_datetime(other_events[\\\"end\\\"])\\n\",","    \"\\n\",","    \"# relative days, counted from day 0 of the matching edition\\n\",","    \"other_events = other_events.merge(editions[[\\\"event_id\\\", \\\"event_name\\\", \\\"event_year\\\", \\\"event_reference_date\\\"]],\\n\",","    \"                                  on=[\\\"event_name\\\", \\\"event_year\\\"], validate=\\\"many_to_one\\\")\\n\",","    \"other_events[\\\"first_day\\\"] = (other_events[\\\"start\\\"] - other_events[\\\"event_reference_date\\\"]).dt.days\\n\",","    \"other_events[\\\"last_day\\\"] = (other_events[\\\"end\\\"] - other_events[\\\"event_reference_date\\\"]).dt.days\\n\",","    \"\\n\",","    \"# check against the relative days of the project's event table\\n\",","    \"expected_days = {\\n\",","    \"    (\\\"SP_2019\\\", \\\"Zürich Openair\\\"): (11, 14), (\\\"SP_2022\\\", \\\"Zürich Openair\\\"): (10, 14),\\n\",","    \"    (\\\"SP_2023\\\", \\\"Zürich Openair\\\"): (10, 14), (\\\"SP_2024\\\", \\\"Zürich Openair\\\"): (13, 14),\\n\",","    \"    (\\\"SP_2025\\\", \\\"Zürich Openair\\\"): (13, 14), (\\\"ZF_2019\\\", \\\"Alba Festival\\\"): (-7, -6),\\n\",","    \"    (\\\"ZF_2023\\\", \\\"Caliente! Latin Music Festival\\\"): (-8, -7), (\\\"ZF_2023\\\", \\\"Coldplay (Letzigrund)\\\"): (-7, -6),\\n\",","    \"}\\n\",","    \"for row in other_events.itertuples():\\n\",","    \"    assert (row.first_day, row.last_day) == expected_days[(row.event_id, row.other_event)], row.other_event\\n\",","    \"\\n\",","    \"other_events[[\\\"event_id\\\", \\\"other_event\\\", \\\"start\\\", \\\"end\\\", \\\"first_day\\\", \\\"last_day\\\", \\\"marker\\\"]]\"","   ]","  },","  {","   \"cell_type\": \"code\",","   \"execution_count\": 8,","   \"id\": \"aaceb380\",","   \"metadata\": {","    \"execution\": {","     \"iopub.execute_input\": \"2026-11-01T16:44:11.693333Z\",","     \"iopub.status.busy\": \"2026-11-01T16:44:11.693175Z\",","     \"iopub.status.idle\": \"2026-11-01T16:44:11.711295Z\",","     \"shell.execute_reply\": \"2026-11-01T16:44:11.710365Z\"","    }","   },","   \"outputs\": [],","   \"source\": [","    \"DISPLAY_DAYS = 14\\n\",","    \"PANEL_ORDER = [\\\"Accommodation\\\", \\\"Transport services\\\", \\\"Food and beverage services\\\"]\\n\",","    \"ROWS = [(\\\"percentage_deviation\\\", \\\"Spending deviation (%)\\\"),\\n\",","    \"        (\\\"tx_percentage_deviation\\\", \\\"Transaction-count deviation (%)\\\")]\\n\",","    \"EDITION_COLORS = dict(zip(editions[\\\"event_id\\\"], plt.cm.tab10.colors))   # one fixed colour per edition\\n\",","    \"EXPECTED_AUGUST_1 = {\\\"SP_2019\\\": -9, \\\"SP_2022\\\": -12, \\\"SP_2023\\\": -11, \\\"SP_2024\\\": -9, \\\"SP_2025\\\": -8}\\n\",","    \"\\n\",","    \"# Street Parade: exploratory periods at full opacity, the rest of each line faded\\n\",","    \"HIGHLIGHT_WINDOWS = {\\\"Accommodation\\\": (-7, 0), \\\"Transport services\\\": (-1, 1), \\\"Food and beverage services\\\": (-7, 1)}\\n\",","    \"FADED_ALPHA = 0.25\\n\",","    \"\\n\",","    \"MARKER_SIZES = {\\\"^\\\": 40, \\\"s\\\": 40, \\\"P\\\": 50, \\\"*\\\": 85}\\n\",","    \"MARKER_SHIFT = 0.42          # side-by-side shift when two other events share a day\\n\",","    \"LEGEND_NAMES = {\\\"Caliente! Latin Music Festival\\\": \\\"Caliente!\\\", \\\"Coldplay (Letzigrund)\\\": \\\"Coldplay\\\"}\\n\",","    \"LEGEND_SIZE = 17             # legends below the panels (readable after scaling to report width)\\n\",","    \"NOTE_SIZE = 16               # notes below the legends\\n\",","    \"\\n\",","    \"\\n\",","    \"def plot_event_figure(event_name, filename):\\n\",","    \"    is_street_parade = event_name == \\\"Street Parade\\\"\\n\",","    \"    marker_alpha = 0.20 if is_street_parade else None    # Street Parade markers are faded on the data\\n\",","    \"    event_editions = editions[editions[\\\"event_name\\\"] == event_name].sort_values(\\\"event_year\\\")\\n\",","    \"    event_markers = other_events[other_events[\\\"event_name\\\"] == event_name]\\n\",","    \"    event_data = results[(results[\\\"event_name\\\"] == event_name)\\n\",","    \"                         & results[\\\"relative_day\\\"].between(-DISPLAY_DAYS, DISPLAY_DAYS)]\\n\",","    \"    placed_markers = []\\n\",","    \"\\n\",","    \"    fig, axes = plt.subplots(2, 3, figsize=(19, 11.5), sharex=True, sharey=\\\"row\\\")\\n\",","    \"    for row_number, (column, y_label) in enumerate(ROWS):\\n\",","    \"        # same y-axis for the three panels of a row, with 5 points of headroom for markers on the peaks\\n\",","    \"        y_limits = (np.floor((event_data[column].min() - 5) / 10) * 10,\\n\",","    \"                    np.ceil((event_data[column].max() + 5) / 10) * 10)\\n\",","    \"\\n\",","    \"        for ax, category in zip(axes[row_number], PANEL_ORDER):\\n\",","    \"            category_data = event_data[event_data[\\\"merchant_category\\\"] == category]\\n\",","    \"\\n\",","    \"            for edition in event_editions.itertuples():\\n\",","    \"                color = EDITION_COLORS[edition.event_id]\\n\",","    \"                line = category_data[category_data[\\\"event_id\\\"] == edition.event_id].sort_values(\\\"relative_day\\\")\\n\",","    \"\\n\",","    \"                # full line; for Street Parade it is faded and the highlighted window is drawn on top\\n\",","    \"                ax.plot(line[\\\"relative_day\\\"], line[column], linewidth=1.4, marker=\\\"o\\\", markersize=2.5, color=color,\\n\",","    \"                        alpha=FADED_ALPHA if is_street_parade else None, label=edition.event_id)\\n\",","    \"                if is_street_parade:\\n\",","    \"                    start, end = HIGHLIGHT_WINDOWS[category]\\n\",","    \"                    window = line[line[\\\"relative_day\\\"].between(start, end)]\\n\",","    \"                    ax.plot(window[\\\"relative_day\\\"], window[column], linewidth=1.4, marker=\\\"o\\\", markersize=2.5,\\n\",","    \"                            color=color)\\n\",","    \"\\n\",","    \"                # 1 August (only inside Street Parade windows)\\n\",","    \"                august_1 = line[(line[\\\"date\\\"].dt.month == 8) & (line[\\\"date\\\"].dt.day == 1)]\\n\",","    \"                if len(august_1) == 1:\\n\",","    \"                    ax.scatter(august_1[\\\"relative_day\\\"], august_1[column], marker=\\\"D\\\", s=70, color=color,\\n\",","    \"                               edgecolors=\\\"black\\\", linewidths=1.5, zorder=5, alpha=marker_alpha)\\n\",","    \"                    assert august_1[\\\"relative_day\\\"].iloc[0] == EXPECTED_AUGUST_1[edition.event_id]\\n\",","    \"\\n\",","    \"                # other events of this edition, on every visible day they cover\\n\",","    \"                edition_events = event_markers[event_markers[\\\"event_id\\\"] == edition.event_id]\\n\",","    \"                for day in range(-DISPLAY_DAYS, DISPLAY_DAYS + 1):\\n\",","    \"                    today = edition_events[(edition_events[\\\"first_day\\\"] \x3C= day) & (edition_events[\\\"last_day\\\"] >= day)]\\n\",","    \"                    for k, event in enumerate(today.itertuples()):\\n\",","    \"                        shift = (k - (len(today) - 1) / 2) * MARKER_SHIFT      # 0 if only one event that day\\n\",","    \"                        value = line.loc[line[\\\"relative_day\\\"] == day, column].iloc[0]\\n\",","    \"                        ax.scatter(day + shift, value, marker=event.marker, s=MARKER_SIZES[event.marker],\\n\",","    \"                                   color=color, edgecolors=\\\"black\\\", linewidths=0.8,\\n\",","    \"                                   zorder=7 if event.marker == \\\"*\\\" else 6, alpha=marker_alpha)\\n\",","    \"                        placed_markers.append((event.event_id, event.other_event, day))\\n\",","    \"\\n\",","    \"            if not is_street_parade:\\n\",","    \"                ax.axvspan(-1.5, 1.5, color=\\\"grey\\\", alpha=0.15)          # three festival days\\n\",","    \"            ax.axvline(0, color=\\\"black\\\", linestyle=\\\":\\\", linewidth=1.2)\\n\",","    \"            ax.axhline(0, color=\\\"#444444\\\", linewidth=1.1, zorder=1)      # baseline, drawn above the grid\\n\",","    \"            ax.set_xlim(-DISPLAY_DAYS - 0.5, DISPLAY_DAYS + 0.5)\\n\",","    \"            ax.set_xticks(range(-DISPLAY_DAYS, DISPLAY_DAYS + 1, 7))\\n\",","    \"            ax.set_ylim(y_limits)\\n\",","    \"            ax.tick_params(labelsize=10.5)\\n\",","    \"            ax.grid(color=\\\"#e3e3e3\\\", linewidth=0.6)\\n\",","    \"            if row_number == 0:\\n\",","    \"                ax.set_title(category, fontsize=15, fontweight=\\\"semibold\\\", pad=10)\\n\",","    \"            else:\\n\",","    \"                ax.set_xlabel(\\\"Days relative to event\\\", fontsize=12)\\n\",","    \"\\n\",","    \"            # every edition line covers all 29 displayed days\\n\",","    \"            full_lines = [l for l in ax.get_lines() if l.get_label() in set(event_editions[\\\"event_id\\\"])]\\n\",","    \"            assert len(full_lines) == len(event_editions)\\n\",","    \"            assert all(list(l.get_xdata()) == list(range(-DISPLAY_DAYS, DISPLAY_DAYS + 1)) for l in full_lines)\\n\",","    \"\\n\",","    \"        axes[row_number][0].set_ylabel(y_label, fontsize=12)\\n\",","    \"\\n\",","    \"    # legend row 1: edition years (own samples at full opacity)\\n\",","    \"    year_handles = [Line2D([], [], linewidth=2.0, marker=\\\"o\\\", markersize=4, color=EDITION_COLORS[e])\\n\",","    \"                    for e in event_editions[\\\"event_id\\\"]]\\n\",","    \"    fig.legend(year_handles, [str(y) for y in event_editions[\\\"event_year\\\"]], loc=\\\"lower center\\\",\\n\",","    \"               bbox_to_anchor=(0.5, 0.062), ncol=len(year_handles), fontsize=LEGEND_SIZE, frameon=False,\\n\",","    \"               handlelength=2.5, columnspacing=2.2)\\n\",","    \"\\n\",","    \"    # legend row 2: other events and holidays, with neutral white symbols\\n\",","    \"    handles = [Line2D([], [], linestyle=\\\"none\\\")]          # empty handle for the bold introduction\\n\",","    \"    labels = [\\\"Other events and holidays:\\\" if is_street_parade else \\\"Other events:\\\"]\\n\",","    \"    if is_street_parade:\\n\",","    \"        handles.append(Line2D([], [], linestyle=\\\"none\\\", marker=\\\"D\\\", markersize=10,\\n\",","    \"                              markerfacecolor=\\\"white\\\", markeredgecolor=\\\"black\\\", markeredgewidth=1.5))\\n\",","    \"        labels.append(\\\"Swiss National Day (Aug 1)\\\")\\n\",","    \"    for name, rows in event_markers.groupby(\\\"other_event\\\", sort=False):\\n\",","    \"        marker = rows[\\\"marker\\\"].iloc[0]\\n\",","    \"        handles.append(Line2D([], [], linestyle=\\\"none\\\", marker=marker, markersize=13 if marker == \\\"*\\\" else 10,\\n\",","    \"                              markerfacecolor=\\\"white\\\", markeredgecolor=\\\"black\\\", markeredgewidth=0.8))\\n\",","    \"        labels.append(LEGEND_NAMES.get(name, name))\\n\",","    \"    event_legend = fig.legend(handles, labels, loc=\\\"lower center\\\", bbox_to_anchor=(0.5, 0.018), ncol=len(handles),\\n\",","    \"                              fontsize=LEGEND_SIZE, frameon=False, handletextpad=0.5, columnspacing=2.2)\\n\",","    \"    event_legend.get_texts()[0].set_fontweight(\\\"bold\\\")\\n\",","    \"\\n\",","    \"    # notes below the legends\\n\",","    \"    if is_street_parade:\\n\",","    \"        first_note = \\\"Day 0 = Street Parade day | Baseline: same-weekday median (±28 days)\\\"\\n\",","    \"        second_note = \\\"Highlighted: exploratory periods | Faded: surrounding context\\\"\\n\",","    \"    else:\\n\",","    \"        first_note = \\\"Day 0 = middle Saturday of the festival | Baseline: same-weekday median (±28 days)\\\"\\n\",","    \"        second_note = \\\"Grey band: three-day festival (Fri–Sun)\\\"\\n\",","    \"    # the notes sit below the legends; bbox_inches=\\\"tight\\\" extends the saved image downwards, panels are unchanged\\n\",","    \"    fig.text(0.5, -0.014, first_note, ha=\\\"center\\\", fontsize=NOTE_SIZE, color=\\\"#333333\\\")\\n\",","    \"    fig.text(0.5, -0.040, second_note, ha=\\\"center\\\", fontsize=NOTE_SIZE, color=\\\"#333333\\\")\\n\",","    \"    fig.subplots_adjust(left=0.06, right=0.99, top=0.95, bottom=0.17, hspace=0.12, wspace=0.06)\\n\",","    \"\\n\",","    \"    # each other-event marker appears once per panel (3 categories x 2 rows) on each day it covers\\n\",","    \"    expected = [(e.event_id, e.other_event, day) for e in event_markers.itertuples()\\n\",","    \"                for day in range(max(e.first_day, -DISPLAY_DAYS), min(e.last_day, DISPLAY_DAYS) + 1)] * 6\\n\",","    \"    assert sorted(placed_markers) == sorted(expected), \\\"other-event markers do not match the event table\\\"\\n\",","    \"\\n\",","    \"    fig.savefig(FIGURE_DIR / filename, dpi=300, bbox_inches=\\\"tight\\\")\\n\",","    \"    fig.savefig(FIGURE_DIR / filename.replace(\\\".png\\\", \\\".pdf\\\"), bbox_inches=\\\"tight\\\")   # vector version for the report\\n\",","    \"    plt.show()\\n\",","    \"    print(f\\\"{event_name}: {len(event_editions)} editions, {len(placed_markers)} other-event markers -> \\\"\\n\",","    \"          f\\\"{FIGURE_DIR / filename} and .pdf\\\")\"","   ]","  },","  {","   \"cell_type\": \"markdown\",","   \"id\": \"4aecbd8b\",","   \"metadata\": {},","   \"source\": [","    \"### Figure: Street Parade\"","   ]","  },","  {","   \"cell_type\": \"code\",","   \"execution_count\": 9,","   \"id\": \"3f9f8e8a\",","   \"metadata\": {","    \"execution\": {","     \"iopub.execute_input\": \"2026-11-01T16:44:11.712882Z\",","     \"iopub.status.busy\": \"2026-11-01T16:44:11.712668Z\",","     \"iopub.status.idle\": \"2026-11-01T16:44:15.565111Z\",","     \"shell.execute_reply\": \"2026-11-01T16:44:15.563910Z\"","    }","   },","   \"outputs\": [","    {","     \"data\": {","      \"image/png\": \"\",","      \"text/plain\": [","       \"\x3CFigure size 1900x1150 with 6 Axes>\"","      ]","     },","     \"metadata\": {},","     \"output_type\": \"display_data\"","    },","    {","     \"name\": \"stdout\",","     \"output_type\": \"stream\",","     \"text\": [","      \"Street Parade: 5 editions, 108 other-event markers -> figures/q1_street_parade_combined.png and .pdf\\n\"","     ]","    }","   ],","   \"source\": [","    \"plot_event_figure(\\\"Street Parade\\\", \\\"q1_street_parade_combined.png\\\")\"","   ]","  },","  {","   \"cell_type\": \"markdown\",","   \"id\": \"756b90a4\",","   \"metadata\": {},","   \"source\": [","    \"### Figure: Züri Fäscht\"","   ]","  },","  {","   \"cell_type\": \"code\",","   \"execution_count\": 10,","   \"id\": \"ccce7871\",","   \"metadata\": {","    \"execution\": {","     \"iopub.execute_input\": \"2026-11-01T16:44:15.567821Z\",","     \"iopub.status.busy\": \"2026-11-01T16:44:15.567395Z\",","     \"iopub.status.idle\": \"2026-11-01T16:44:18.103237Z\",","     \"shell.execute_reply\": \"2026-11-01T16:44:18.100395Z\"","    }","   },","   \"outputs\": [","    {","     \"data\": {","      \"image/png\": \"\",","      \"text/plain\": [","       \"\x3CFigure size 1900x1150 with 6 Axes>\"","      ]","     },","     \"metadata\": {},","     \"output_type\": \"display_data\"","    },","    {","     \"name\": \"stdout\",","     \"output_type\": \"stream\",","     \"text\": [","      \"Züri Fäscht: 2 editions, 36 other-event markers -> figures/q1_zueri_faescht_combined.png and .pdf\\n\"","     ]","    }","   ],","   \"source\": [","    \"plot_event_figure(\\\"Züri Fäscht\\\", \\\"q1_zueri_faescht_combined.png\\\")\"","   ]","  },","  {","   \"cell_type\": \"markdown\",","   \"id\": \"e0b74f24\",","   \"metadata\": {},","   \"source\": [","    \"**Note on the other events.** The markers show dates on which other major festivals or concerts took place within the window. These events may contribute to the deviations, but overlap in time alone does not establish a causal relationship.\\n\",","    \"\\n\",","    \"Transport spending and transaction counts were elevated during several days before Züri Fäscht 2023:\\n\",","    \"* **Days −12 to −9 (26–29 June 2023):** spending was 40–63% above the baseline, while transaction counts were only modestly higher (+5% to +10%).\\n\",","    \"* **Days −8 to −6 (30 June–2 July):** spending stayed high (+27% to +63%) and transaction counts rose to +17% to +28%.\\n\",","    \"\\n\",","    \"Coldplay and Caliente! coincided with part of this period (days −8 to −6), but the earlier increases remain unexplained by the identified events.\\n\",","    \"\\n\",","    \"**Check:** the displayed windows of Street Parade and Züri Fäscht must not overlap in 2019 and 2023.\"","   ]","  },","  {","   \"cell_type\": \"code\",","   \"execution_count\": 11,","   \"id\": \"f64ffeac\",","   \"metadata\": {","    \"execution\": {","     \"iopub.execute_input\": \"2026-11-01T16:44:18.108179Z\",","     \"iopub.status.busy\": \"2026-11-01T16:44:18.107862Z\",","     \"iopub.status.idle\": \"2026-11-01T16:44:18.121728Z\",","     \"shell.execute_reply\": \"2026-11-01T16:44:18.120409Z\"","    }","   },","   \"outputs\": [","    {","     \"name\": \"stdout\",","     \"output_type\": \"stream\",","     \"text\": [","      \"2019: Züri Fäscht 2019-06-22 to 2019-07-20, Street Parade 2019-07-27 to 2019-08-24 - no shared dates\\n\",","      \"2023: Züri Fäscht 2023-06-24 to 2023-07-22, Street Parade 2023-07-29 to 2023-08-26 - no shared dates\\n\"","     ]","    }","   ],","   \"source\": [","    \"displayed = results[results[\\\"relative_day\\\"].between(-DISPLAY_DAYS, DISPLAY_DAYS)]\\n\",","    \"for year in [2019, 2023]:\\n\",","    \"    sp_dates = set(displayed.loc[displayed[\\\"event_id\\\"] == f\\\"SP_{year}\\\", \\\"date\\\"])\\n\",","    \"    zf_dates = set(displayed.loc[displayed[\\\"event_id\\\"] == f\\\"ZF_{year}\\\", \\\"date\\\"])\\n\",","    \"    assert not sp_dates & zf_dates, f\\\"{year}: overlapping display windows\\\"\\n\",","    \"    print(f\\\"{year}: Züri Fäscht {min(zf_dates).date()} to {max(zf_dates).date()}, \\\"\\n\",","    \"          f\\\"Street Parade {min(sp_dates).date()} to {max(sp_dates).date()} - no shared dates\\\")\"","   ]","  },","  {","   \"cell_type\": \"markdown\",","   \"id\": \"feccd3cb\",","   \"metadata\": {},","   \"source\": [","    \"## 6. Event-day comparison and summary statistics\\n\",","    \"\\n\",","    \"The heatmap shows the observed event-day deviation in spending from the baseline for each edition and category. For Züri Fäscht it is the mean of the three daily deviations (Friday, Saturday, Sunday), each with its own weekday baseline; the percentages are averaged, not added up. The colour scale is centred at 0% and symmetric.\"","   ]","  },","  {","   \"cell_type\": \"code\",","   \"execution_count\": 12,","   \"id\": \"8010ef60\",","   \"metadata\": {","    \"execution\": {","     \"iopub.execute_input\": \"2026-11-01T16:44:18.124776Z\",","     \"iopub.status.busy\": \"2026-11-01T16:44:18.123725Z\",","     \"iopub.status.idle\": \"2026-11-01T16:44:18.436713Z\",","     \"shell.execute_reply\": \"2026-11-01T16:44:18.435514Z\"","    }","   },","   \"outputs\": [","    {","     \"data\": {","      \"image/png\": \"\",","      \"text/plain\": [","       \"\x3CFigure size 900x600 with 2 Axes>\"","      ]","     },","     \"metadata\": {},","     \"output_type\": \"display_data\"","    }","   ],","   \"source\": [","    \"event_results = results[results[\\\"is_event_day\\\"]]\\n\",","    \"edition_means = (event_results.groupby([\\\"event_name\\\", \\\"event_year\\\", \\\"merchant_category\\\"])[\\\"percentage_deviation\\\"]\\n\",","    \"                 .mean().unstack(\\\"merchant_category\\\")[CATEGORIES])\\n\",","    \"assert edition_means.shape == (7, 3)\\n\",","    \"\\n\",","    \"heatmap_data = edition_means.copy()\\n\",","    \"heatmap_data.index = [f\\\"{name} {year}\\\" for name, year in heatmap_data.index]\\n\",","    \"limit = np.ceil(heatmap_data.abs().max().max() / 10) * 10      # same limit on both sides of 0\\n\",","    \"labels = heatmap_data.map(lambda value: f\\\"{value:+.0f}%\\\")\\n\",","    \"\\n\",","    \"fig, ax = plt.subplots(figsize=(9, 6))\\n\",","    \"sns.heatmap(heatmap_data, annot=labels, fmt=\\\"\\\", cmap=\\\"RdBu_r\\\", center=0, vmin=-limit, vmax=limit,\\n\",","    \"            linewidths=0.5, cbar_kws={\\\"label\\\": \\\"Deviation from comparable non-event days (%)\\\"}, ax=ax)\\n\",","    \"ax.set_title(\\\"Event-day spending deviation by edition and merchant category\\\\n\\\"\\n\",","    \"             \\\"(Züri Fäscht: mean of Friday, Saturday and Sunday)\\\")\\n\",","    \"ax.set_xlabel(\\\"Merchant category\\\")\\n\",","    \"ax.set_ylabel(\\\"\\\")\\n\",","    \"fig.tight_layout()\\n\",","    \"fig.savefig(FIGURE_DIR / \\\"q1_event_heatmap.png\\\", dpi=150)\