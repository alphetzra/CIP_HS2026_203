GatedFeatureMessage:null,showPlanSupportBanner:null,upgradeDataAttributes:null,upgradePath:null},publishBannersInfo:$R[382]={dismissActionNoticePath:"/settings/dismiss-notice/publish_action_from_dockerfile",releasePath:"/alphetzra/CIP_HS2026_203/releases/new?marketplace=true",showPublishActionBanner:!1},rawBlobUrl:"https://github.com/alphetzra/CIP_HS2026_203/raw/refs/heads/morteza/RQ-1/code/02_data_cleaning_transformation_integration.ipynb",renderImageOrRaw:!1,shortPath:null,symbolsEnabled:!0,tabSize:4,topBannersInfo:$R[383]={overridingGlobalFundingFile:!1,globalPreferredFundingPath:null,showInvalidCitationWarning:!1,citationHelpUrl:"https://docs.github.com/github/creating-cloning-and-archiving-repositories/creating-a-repository-on-github/about-citation-files",actionsOnboardingTip:null},truncated:!1,viewable:!0,workflowRedirectUrl:null},copilotInfo:null,copilotAccessAllowed:!0,copilotSpacesEnabled:!0,modelsAccessAllowed:!1,modelsRepoIntegrationEnabled:!1,isMarketplaceEnabled:!0}},dataUpdateCount:1,dataUpdatedAt:1793826824552,error:null,errorUpdateCount:0,errorUpdatedAt:0,fetchFailureCount:0,fetchFailureReason:null,fetchMeta:null,isInvalidated:!1,status:"success",fetchStatus:"idle"},queryKey:$R[260],queryHash:"[\"code-view\",\"codeViewBlobLayoutRoute\",\"\",\"mainQuery\",{\"pathname\":\"/alphetzra/CIP_HS2026_203/_layout/morteza/RQ-1/code/02_data_cleaning_transformation_integration.ipynb\"}]"},$R[384]={dehydratedAt:1793826824553,state:$R[385]={data:$R[386]={payload:$R[387]={"codeViewBlobLayoutRoute.StyledBlob":$R[388]={rawLines:$R[389]=["{"," \"cells\": [","  {","   \"cell_type\": \"markdown\",","   \"id\": \"e2aede0a\",","   \"metadata\": {},","   \"source\": [","    \"# 02 – Data Cleaning, Transformation & Integration (V2)\\n\",","    \"\\n\",","    \"**Research question Q1:** How do major events in Canton Zürich relate to daily POS spending across merchant categories compared with similar non-event days? (2019–2025)\\n\",","    \"\\n\",","    \"In this notebook we prepare the data for the analysis in Notebook 03. We\\n\",","    \"1. clean the daily Zürich spending data for three merchant categories,\\n\",","    \"2. combine the 11 event days into 7 event editions,\\n\",","    \"3. create a window of ±28 days around every edition,\\n\",","    \"4. join the windows with the spending data and export three CSV files.\\n\",","    \"\\n\",","    \"Main decisions:\\n\",","    \"* **One row per edition:** Züri Fäscht lasts three days but counts as one edition, not three separate events.\\n\",","    \"* **Day 0:** the Street Parade day, or the Saturday (middle day) of Züri Fäscht. Friday is then day −1 and Sunday day +1.\\n\",","    \"* **Attendance per edition only:** we do not use `estimated_daily_attendance`, because the sources do not support splitting attendance equally across days.\\n\",","    \"* **Spending values unchanged:** we do not rescale them. MCS divides all values by the same number, so percentage comparisons remain valid.\\n\",","    \"\\n\",","    \"Each step is written as a function. The export at the end runs all steps again from the input files, so a file is only saved if every check passes.\"","   ]","  },","  {","   \"cell_type\": \"markdown\",","   \"id\": \"71fb4d08\",","   \"metadata\": {},","   \"source\": [","    \"## 2. Load datasets\\n\",","    \"\\n\",","    \"The notebook must be run from the project folder (the folder that contains `data/`). The input files are only read, never changed.\"","   ]","  },","  {","   \"cell_type\": \"code\",","   \"execution_count\": 1,","   \"id\": \"f1b5a244\",","   \"metadata\": {","    \"execution\": {","     \"iopub.execute_input\": \"2026-10-31T15:08:01.537620Z\",","     \"iopub.status.busy\": \"2026-10-31T15:08:01.536674Z\",","     \"iopub.status.idle\": \"2026-10-31T15:08:02.236666Z\",","     \"shell.execute_reply\": \"2026-10-31T15:08:02.232508Z\"","    }","   },","   \"outputs\": [","    {","     \"name\": \"stdout\",","     \"output_type\": \"stream\",","     \"text\": [","      \"Spending: (156664, 5)\\n\",","      \"Events:   (11, 8)\\n\"","     ]","    }","   ],","   \"source\": [","    \"from pathlib import Path\\n\",","    \"\\n\",","    \"import numpy as np\\n\",","    \"import pandas as pd\\n\",","    \"\\n\",","    \"SPENDING_FILE = Path(\\\"data/raw/ACQ_POS_Grossregion_NOGA.csv\\\")\\n\",","    \"EVENTS_FILE = Path(\\\"data/processed/zurich_event_days.csv\\\")\\n\",","    \"OUTPUT_DIR = Path(\\\"data/processed\\\")\\n\",","    \"\\n\",","    \"START_DATE = \\\"2019-01-01\\\"\\n\",","    \"END_DATE = \\\"2025-12-31\\\"\\n\",","    \"CATEGORIES = [\\\"Accommodation\\\", \\\"Food and beverage services\\\", \\\"Transport services\\\"]  # exact labels in the data\\n\",","    \"WINDOW_DAYS = 28\\n\",","    \"\\n\",","    \"\\n\",","    \"def load_inputs():\\n\",","    \"    for file in [SPENDING_FILE, EVENTS_FILE]:\\n\",","    \"        if not file.exists():\\n\",","    \"            raise FileNotFoundError(f\\\"{file} not found - run the notebook from the project folder\\\")\\n\",","    \"    # Region contains the code \\\"9999\\\", so both text columns are read as strings\\n\",","    \"    spending_raw = pd.read_csv(SPENDING_FILE, dtype={\\\"Region\\\": str, \\\"Merchant category\\\": str})\\n\",","    \"    # the event file was saved with a BOM (for Excel), utf-8-sig removes it\\n\",","    \"    events_raw = pd.read_csv(EVENTS_FILE, encoding=\\\"utf-8-sig\\\")\\n\",","    \"    return spending_raw, events_raw\\n\",","    \"\\n\",","    \"\\n\",","    \"spending_raw, events_raw = load_inputs()\\n\",","    \"print(\\\"Spending:\\\", spending_raw.shape)\\n\",","    \"print(\\\"Events:  \\\", events_raw.shape)\"","   ]","  },","  {","   \"cell_type\": \"markdown\",","   \"id\": \"2855f34f\",","   \"metadata\": {},","   \"source\": [","    \"## 3. Validate and clean spending data\\n\",","    \"\\n\",","    \"We first check the full spending file:\\n\",","    \"* expected columns,\\n\",","    \"* no missing values,\\n\",","    \"* valid dates,\\n\",","    \"* positive numeric values,\\n\",","    \"* no duplicate records.\\n\",","    \"\\n\",","    \"We then keep only Zürich, 2019–2025 and the three merchant categories. Every category must have one value for each of the 2,557 days, which gives 7,671 rows. Problems stop the notebook; duplicates are not averaged and gaps are not filled.\"","   ]","  },","  {","   \"cell_type\": \"code\",","   \"execution_count\": 2,","   \"id\": \"5dfd6d20\",","   \"metadata\": {","    \"execution\": {","     \"iopub.execute_input\": \"2026-10-31T15:08:02.239263Z\",","     \"iopub.status.busy\": \"2026-10-31T15:08:02.239068Z\",","     \"iopub.status.idle\": \"2026-10-31T15:08:02.369627Z\",","     \"shell.execute_reply\": \"2026-10-31T15:08:02.368399Z\"","    }","   },","   \"outputs\": [","    {","     \"name\": \"stdout\",","     \"output_type\": \"stream\",","     \"text\": [","      \"Clean spending: (7671, 5)\\n\",","      \"                            count        min        max\\n\",","      \"merchant_category                                      \\n\",","      \"Accommodation                2557 2019-01-01 2025-12-31\\n\",","      \"Food and beverage services   2557 2019-01-01 2025-12-31\\n\",","      \"Transport services           2557 2019-01-01 2025-12-31\\n\"","     ]","    }","   ],","   \"source\": [","    \"def clean_spending(spending_raw):\\n\",","    \"    expected_columns = [\\\"Date\\\", \\\"Region\\\", \\\"Merchant category\\\", \\\"Scaled Value\\\", \\\"Scaled Number of Transactions\\\"]\\n\",","    \"    assert list(spending_raw.columns) == expected_columns, f\\\"Unexpected columns: {list(spending_raw.columns)}\\\"\\n\",","    \"    assert spending_raw.notna().all().all(), \\\"Spending data contain missing values\\\"\\n\",","    \"\\n\",","    \"    spending = spending_raw.rename(columns={\\n\",","    \"        \\\"Date\\\": \\\"date\\\",\\n\",","    \"        \\\"Region\\\": \\\"region\\\",\\n\",","    \"        \\\"Merchant category\\\": \\\"merchant_category\\\",\\n\",","    \"        \\\"Scaled Value\\\": \\\"scaled_value\\\",\\n\",","    \"        \\\"Scaled Number of Transactions\\\": \\\"scaled_n_transactions\\\",\\n\",","    \"    })\\n\",","    \"    spending[\\\"date\\\"] = pd.to_datetime(spending[\\\"date\\\"], format=\\\"%Y-%m-%d\\\")  # fails on an invalid date\\n\",","    \"\\n\",","    \"    for column in [\\\"scaled_value\\\", \\\"scaled_n_transactions\\\"]:\\n\",","    \"        assert pd.api.types.is_numeric_dtype(spending[column]), f\\\"{column} is not numeric\\\"\\n\",","    \"        assert np.isfinite(spending[column]).all(), f\\\"{column} contains infinite values\\\"\\n\",","    \"        assert (spending[column] > 0).all(), f\\\"{column} contains zero or negative values\\\"\\n\",","    \"\\n\",","    \"    duplicates = spending.duplicated([\\\"date\\\", \\\"region\\\", \\\"merchant_category\\\"]).sum()\\n\",","    \"    assert duplicates == 0, f\\\"{duplicates} duplicate date/region/category records\\\"\\n\",","    \"\\n\",","    \"    # keep Zürich, 2019-2025 and the three categories\\n\",","    \"    is_zurich = spending[\\\"region\\\"] == \\\"Zurich\\\"\\n\",","    \"    in_period = spending[\\\"date\\\"].between(START_DATE, END_DATE)\\n\",","    \"    in_categories = spending[\\\"merchant_category\\\"].isin(CATEGORIES)\\n\",","    \"    spending = spending[is_zurich & in_period & in_categories]\\n\",","    \"    spending = spending.sort_values([\\\"date\\\", \\\"merchant_category\\\"]).reset_index(drop=True)\\n\",","    \"\\n\",","    \"    # every category needs exactly one value per day\\n\",","    \"    all_days = pd.date_range(START_DATE, END_DATE)\\n\",","    \"    for category in CATEGORIES:\\n\",","    \"        days = spending.loc[spending[\\\"merchant_category\\\"] == category, \\\"date\\\"]\\n\",","    \"        assert len(days) == len(all_days) and set(days) == set(all_days), f\\\"{category}: dates missing or duplicated\\\"\\n\",","    \"\\n\",","    \"    assert len(spending) == 7671, f\\\"Expected 7,671 rows, found {len(spending)}\\\"\\n\",","    \"    return spending\\n\",","    \"\\n\",","    \"\\n\",","    \"spending = clean_spending(spending_raw)\\n\",","    \"print(\\\"Clean spending:\\\", spending.shape)\\n\",","    \"print(spending.groupby(\\\"merchant_category\\\")[\\\"date\\\"].agg([\\\"count\\\", \\\"min\\\", \\\"max\\\"]))\"","   ]","  },","  {","   \"cell_type\": \"markdown\",","   \"id\": \"37d3a64a\",","   \"metadata\": {},","   \"source\": [","    \"## 4. Validate and prepare event data\\n\",","    \"\\n\",","    \"The event file has one row per event day. We check that, within each edition:\\n\",","    \"* the day numbers follow the dates (1, 2, 3),\\n\",","    \"* the days are consecutive,\\n\",","    \"* the year matches the date,\\n\",","    \"* attendance and sources are the same on every day.\\n\",","    \"\\n\",","    \"We then combine the days into one row per edition. Day 0 (`event_reference_date`) is the middle day, which is the Saturday for both events. The `event_id` is built from the initials and the year, e.g. `SP_2019` or `ZF_2023`.\"","   ]","  },","  {","   \"cell_type\": \"code\",","   \"execution_count\": 3,","   \"id\": \"a0563636\",","   \"metadata\": {","    \"execution\": {","     \"iopub.execute_input\": \"2026-10-31T15:08:02.371388Z\",","     \"iopub.status.busy\": \"2026-10-31T15:08:02.371217Z\",","     \"iopub.status.idle\": \"2026-10-31T15:08:02.411263Z\",","     \"shell.execute_reply\": \"2026-10-31T15:08:02.410116Z\"","    }","   },","   \"outputs\": [","    {","     \"data\": {","      \"text/html\": [","       \"\x3Cdiv>\\n\",","       \"\x3Cstyle scoped>\\n\",","       \"    .dataframe tbody tr th:only-of-type {\\n\",","       \"        vertical-align: middle;\\n\",","       \"    }\\n\",","       \"\\n\",","       \"    .dataframe tbody tr th {\\n\",","       \"        vertical-align: top;\\n\",","       \"    }\\n\",","       \"\\n\",","       \"    .dataframe the