 \"4  SP_2023  Street Parade        2023       2023-08-12     2023-08-12   \\n\",","       \"5  SP_2024  Street Parade        2024       2024-08-10     2024-08-10   \\n\",","       \"6  SP_2025  Street Parade        2025       2025-08-09     2025-08-09   \\n\",","       \"\\n\",","       \"  event_reference_date  event_duration_days  edition_attendance  \\\\\\n\",","       \"0           2019-07-06                    3             2500000   \\n\",","       \"1           2019-08-10                    1              850000   \\n\",","       \"2           2022-08-13                    1              900000   \\n\",","       \"3           2023-07-08                    3             2000000   \\n\",","       \"4           2023-08-12                    1              920000   \\n\",","       \"5           2024-08-10                    1              920000   \\n\",","       \"6           2025-08-09                    1              800000   \\n\",","       \"\\n\",","       \"                                         date_source  \\\\\\n\",","       \"0  https://www.zhk.ch/de/wirtschaft-und-politik/m...   \\n\",","       \"1  https://www.stadt-zuerich.ch/misc/de/mitteilun...   \\n\",","       \"2  https://www.stadt-zuerich.ch/de/aktuell/medien...   \\n\",","       \"3      https://www.freizeit.ch/kalender/zuri-fascht/   \\n\",","       \"4  https://polizei.news/2023/08/09/stadt-zuerich-...   \\n\",","       \"5  https://www.polizeinews.ch/2024/08/06/stadt-zu...   \\n\",","       \"6  https://polizeiticker.ch/artikel/street-parade...   \\n\",","       \"\\n\",","       \"                                   attendance_source  \\n\",","       \"0  https://de.wikipedia.org/wiki/Z%C3%BCri_F%C3%A...  \\n\",","       \"1           https://www.streetparade.com/en/historie  \\n\",","       \"2           https://www.streetparade.com/en/historie  \\n\",","       \"3  https://www.swissinfo.ch/eng/society/two-milli...  \\n\",","       \"4           https://www.streetparade.com/en/historie  \\n\",","       \"5           https://www.streetparade.com/en/historie  \\n\",","       \"6           https://www.streetparade.com/en/historie  \"","      ]","     },","     \"execution_count\": 3,","     \"metadata\": {},","     \"output_type\": \"execute_result\"","    }","   ],","   \"source\": [","    \"def make_event_id(name, year):\\n\",","    \"    initials = \\\"\\\".join(word[0] for word in name.split())   # \\\"Street Parade\\\" -> \\\"SP\\\"\\n\",","    \"    return f\\\"{initials}_{year}\\\"\\n\",","    \"\\n\",","    \"\\n\",","    \"def prepare_editions(events_raw):\\n\",","    \"    expected_columns = [\\\"date\\\", \\\"event_name\\\", \\\"event_year\\\", \\\"edition_attendance\\\", \\\"estimated_daily_attendance\\\",\\n\",","    \"                        \\\"event_day_number\\\", \\\"date_source\\\", \\\"attendance_source\\\"]\\n\",","    \"    assert list(events_raw.columns) == expected_columns, f\\\"Unexpected columns: {list(events_raw.columns)}\\\"\\n\",","    \"    assert events_raw.notna().all().all(), \\\"Event data contain missing values\\\"\\n\",","    \"\\n\",","    \"    events = events_raw.copy()\\n\",","    \"    events[\\\"date\\\"] = pd.to_datetime(events[\\\"date\\\"], format=\\\"%Y-%m-%d\\\")\\n\",","    \"    events = events.sort_values([\\\"event_name\\\", \\\"event_year\\\", \\\"date\\\"])\\n\",","    \"    assert (events[\\\"event_year\\\"] == events[\\\"date\\\"].dt.year).all(), \\\"event_year does not match the event date\\\"\\n\",","    \"    assert not events.duplicated([\\\"event_name\\\", \\\"event_year\\\", \\\"date\\\"]).any(), \\\"Duplicate date within an edition\\\"\\n\",","    \"\\n\",","    \"    rows = []\\n\",","    \"    for (name, year), days in events.groupby([\\\"event_name\\\", \\\"event_year\\\"]):\\n\",","    \"        n_days = len(days)\\n\",","    \"        assert days[\\\"event_day_number\\\"].tolist() == list(range(1, n_days + 1)), f\\\"{name} {year}: wrong day numbers\\\"\\n\",","    \"        assert (days[\\\"date\\\"].diff().dropna() == pd.Timedelta(days=1)).all(), f\\\"{name} {year}: days not consecutive\\\"\\n\",","    \"        for column in [\\\"edition_attendance\\\", \\\"date_source\\\", \\\"attendance_source\\\"]:\\n\",","    \"            assert days[column].nunique() == 1, f\\\"{name} {year}: different {column} values\\\"\\n\",","    \"\\n\",","    \"        start, end = days[\\\"date\\\"].min(), days[\\\"date\\\"].max()\\n\",","    \"        rows.append({\\n\",","    \"            \\\"event_id\\\": make_event_id(name, year),\\n\",","    \"            \\\"event_name\\\": name,\\n\",","    \"            \\\"event_year\\\": year,\\n\",","    \"            \\\"event_start_date\\\": start,\\n\",","    \"            \\\"event_end_date\\\": end,\\n\",","    \"            \\\"event_reference_date\\\": start + pd.Timedelta(days=(n_days - 1) // 2),   # middle day\\n\",","    \"            \\\"event_duration_days\\\": n_days,\\n\",","    \"            \\\"edition_attendance\\\": days[\\\"edition_attendance\\\"].iloc[0],\\n\",","    \"            \\\"date_source\\\": days[\\\"date_source\\\"].iloc[0],\\n\",","    \"            \\\"attendance_source\\\": days[\\\"attendance_source\\\"].iloc[0],\\n\",","    \"        })\\n\",","    \"    editions = pd.DataFrame(rows).sort_values(\\\"event_start_date\\\").reset_index(drop=True)\\n\",","    \"\\n\",","    \"    # expected selection: 5 one-day Street Parades and 2 three-day Züri Fäscht editions, always centred on a Saturday\\n\",","    \"    durations = editions.groupby(\\\"event_name\\\")[\\\"event_duration_days\\\"].apply(list).to_dict()\\n\",","    \"    assert durations == {\\\"Street Parade\\\": [1] * 5, \\\"Züri Fäscht\\\": [3] * 2}, f\\\"Unexpected editions: {durations}\\\"\\n\",","    \"    assert (editions[\\\"event_reference_date\\\"].dt.day_name() == \\\"Saturday\\\").all(), \\\"Day 0 is not always a Saturday\\\"\\n\",","    \"    return editions\\n\",","    \"\\n\",","    \"\\n\",","    \"editions = prepare_editions(events_raw)\\n\",","    \"editions\"","   ]","  },","  {","   \"cell_type\": \"markdown\",","   \"id\": \"a47ce897\",","   \"metadata\": {},","   \"source\": [","    \"## 5. Create event windows\\n\",","    \"\\n\",","    \"For every edition we create the 57 days from day −28 to day +28. `is_event_day` marks the actual event days: day 0 for Street Parade and days −1, 0 and +1 for Züri Fäscht.\\n\",","    \"\\n\",","    \"`is_event_day = False` only means \\\"not an event day\\\". Which of these days are suitable as a baseline is decided in Notebook 03.\"","   ]","  },","  {","   \"cell_type\": \"code\",","   \"execution_count\": 4,","   \"id\": \"031d2070\",","   \"metadata\": {","    \"execution\": {","     \"iopub.execute_input\": \"2026-10-31T15:08:02.414075Z\",","     \"iopub.status.busy\": \"2026-10-31T15:08:02.413106Z\",","     \"iopub.status.idle\": \"2026-10-31T15:08:02.439291Z\",","     \"shell.execute_reply\": \"2026-10-31T15:08:02.438223Z\"","    }","   },","   \"outputs\": [","    {","     \"name\": \"stdout\",","     \"output_type\": \"stream\",","     \"text\": [","      \"Window days:\"","     ]","    },","    {","     \"name\": \"stdout\",","     \"output_type\": \"stream\",","     \"text\": [","      \" 399\\n\",","      \"Event days: {'SP_2019': [0], 'SP_2022': [0], 'SP_2023': [0], 'SP_2024': [0], 'SP_2025': [0], 'ZF_2019': [-1, 0, 1], 'ZF_2023': [-1, 0, 1]}\\n\",","      \"Calendar dates that appear in two windows: 44\\n\"","     ]","    }","   ],","   \"source\": [","    \"def create_windows(editions):\\n\",","    \"    rows = []\\n\",","    \"    for _, edition in editions.iterrows():\\n\",","    \"        for relative_day in range(-WINDOW_DAYS, WINDOW_DAYS + 1):\\n\",","    \"            date = edition[\\\"event_reference_date\\\"] + pd.Timedelta(days=relative_day)\\n\",","    \"            rows.append({\\n\",","    \"                \\\"event_id\\\": edition[\\\"event_id\\\"],\\n\",","    \"                \\\"date\\\": date,\\n\",","    \"                \\\"relative_day\\\": relative_day,\\n\",","    \"                \\\"is_event_day\\\": edition[\\\"event_start_date\\\"] \x3C= date \x3C= edition[\\\"event_end_date\\\"],\\n\",","    \"            })\\n\",","    \"    windows = pd.DataFrame(rows)\\n\",","    \"\\n\",","    \"    # check the event-day flags: 1-day event -> day 0, 3-day event -> days -1, 0, +1\\n\",","    \"    event_days = windows[windows[\\\"is_event_day\\\"]]\\n\",","    \"    for _, edition in editions.iterrows():\\n\",","    \"        flagged = event_days.loc[event_days[\\\"event_id\\\"] == edition[\\\"event_id\\\"], \\\"relative_day\\\"].tolist()\\n\",","    \"        half = (edition[\\\"event_duration_days\\\"] - 1) // 2\\n\",","    \"        assert flagged == list(range(-half, half + 1)), f\\\"{edition['event_id']}: wrong event days {flagged}\\\"\\n\",","    \"    assert len(event_days) == 11, f\\\"Expected 11 event days, found {len(event_days)}\\\"\\n\",","    \"    assert len(windows) == len(editions) * 57, \\\"Every edition needs 57 window days\\\"\\n\",","    \"    return windows\\n\",","    \"\\n\",","    \"\\n\",","    \"windows = create_windows(editions)\\n\",","    \"print(\\\"Window days:\\\", len(windows))\\n\",","    \"print(\\\"Event days:\\\", windows[windows[\\\"is_event_day\\\"]].groupby(\\\"event_id\\\")[\\\"relative_day\\\"].apply(list).to_dict())\\n\",","    \"print(\\\"Calendar dates that appear in two windows:\\\", windows[\\\"date\\\"].duplicated().sum())\"","   ]","  },","  {","   \"cell_type\": \"markdown\",","   \"id\": \"c4293894\",","   \"metadata\": {},","   \"source\": [","    \"## 6. Integrate datasets\\n\",","    \"\\n\",","    \"Each window day is repeated for the three merchant categories and then joined with the spending data on `date` and `merchant_category`.\\n\",","    \"\\n\",","    \"`validate=\\\"many_to_one\\\"` makes pandas stop if the spending data have more than one row for a date and category. If two windows share a calendar date, that date stays in both windows as separate rows. The result has one row per edition × day × category.\"","   ]","  },","  {","   \"cell_type\": \"code\",","   \"execution_count\": 5,","   \"id\": \"2f623f29\",","   \"metadata\": {","    \"execution\": {","     \"iopub.execute_input\": \"2026-10-31T15:08:02.441939Z\",","     \"iopub.status.busy\": \"2026-10-31T15:08:02.441260Z\",","     \"iopub.status.idle\": \"2026-10-31T15:08:02.468249Z\",","     \"shell.execute_reply\": \"2026-10-31T15:08:02.467275Z\"","    }","   },","   \"outputs\": [","    {","     \"name\": \"stdout\",","     \"output_type\": \"stream\",","     \"text\": [","      \"Integrated: (1197, 7)\\n\"","     ]","    },","    {","     \"data\": {","      \"text/html\": [","       \"\x3Cdiv>\\n\",","       \"\x3Cstyle scoped>\\n\",","       \"    .dataframe tbody tr th:only-of-type {\\n\",","       \"        vertical-align: middle;\\n\",","       \"    }\\n\",","       \"\\n\",","       \"    .dataframe tbody tr th {\\n\",","       \"        vertical-align: top;\\n\",","       \"    }\\n\",","       \"\\n\",","       \"    .dataframe thead th {\\n\",","       \"        text-align: right;\\n\",","       \"    }\\n\",","       \"\x3C/style>\\n\",","       \"\x3Ctable border=\\\"1\\\" class=\\\"dataframe\\\">\\n\",","       \"  \x3Cthead>\\n\",","       \"    \x3Ctr style=\\\"text-align: right;\\\">\\n\",","       \"      \x3Cth>\x3C/th>\\n\",","       \"      \x3Cth>event_id\x3C/th>\\n\",","       \"      \x3Cth>date\x3C/th>\\n\",","       \"      \x3Cth>relative_day\x3C/th>\\n\",","       \"      \x3Cth>is_event_day\x3C/th>\\n\",","       \"      \x3Cth>merchant_category\x3C/th>\\n\",","       \"      \x3Cth>scaled_value\x3C/th>\\n\",","       \"      \x3Cth>scaled_n_transactions\x3C/th>\\n\",","       \"    \x3C/tr>\\n\",","       \"  \x3C/thead>\\n\",","       \"  \x3Ctbody>\\n\",","       \"    \x3Ctr>\\n\",","       \"      \x3Cth>0\x3C/th>\\n\",","       \"      \x3Ctd>ZF_2019\x3C/td>\\n\",","