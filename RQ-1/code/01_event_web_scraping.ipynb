etadata\": {},","   \"source\": [","    \"## 1. Imports\"","   ]","  },","  {","   \"cell_type\": \"code\",","   \"execution_count\": 2,","   \"id\": \"8a35c27f\",","   \"metadata\": {},","   \"outputs\": [],","   \"source\": [","    \"import os\\n\",","    \"import re\\n\",","    \"import time\\n\",","    \"from urllib import robotparser\\n\",","    \"\\n\",","    \"import requests\\n\",","    \"from bs4 import BeautifulSoup\\n\",","    \"import pandas as pd\\n\",","    \"\\n\",","    \"myheaders = {\\\"User-Agent\\\": \\\"Mozilla/5.0 (compatible; HSLU-CIP-student-project)\\\"}\"","   ]","  },","  {","   \"cell_type\": \"markdown\",","   \"id\": \"6f36b749\",","   \"metadata\": {},","   \"source\": [","    \"`get_page()` checks `robots.txt` first and only downloads the page if scraping is allowed.\\n\",","    \"If `robots.txt` cannot be read, the page is skipped (only a missing `robots.txt`, status 404, counts as \\\"no restrictions\\\").\"","   ]","  },","  {","   \"cell_type\": \"code\",","   \"execution_count\": 3,","   \"id\": \"682be16e\",","   \"metadata\": {},","   \"outputs\": [],","   \"source\": [","    \"def get_page(url):\\n\",","    \"    site = \\\"/\\\".join(url.split(\\\"/\\\")[:3])\\n\",","    \"    try:\\n\",","    \"        robots = requests.get(site + \\\"/robots.txt\\\", headers=myheaders, timeout=20)\\n\",","    \"        if robots.status_code == 200:\\n\",","    \"            rp = robotparser.RobotFileParser()\\n\",","    \"            rp.parse(robots.text.splitlines())\\n\",","    \"            if not rp.can_fetch(myheaders[\\\"User-Agent\\\"], url):\\n\",","    \"                print(\\\"Not allowed by robots.txt:\\\", url)\\n\",","    \"                return None\\n\",","    \"        elif robots.status_code != 404:\\n\",","    \"            print(\\\"robots.txt could not be checked, page skipped:\\\", url)\\n\",","    \"            return None\\n\",","    \"        page = requests.get(url, headers=myheaders, timeout=20)\\n\",","    \"    except requests.RequestException:\\n\",","    \"        print(\\\"Request failed:\\\", url)\\n\",","    \"        return None\\n\",","    \"    time.sleep(1)\\n\",","    \"    if page.status_code != 200:\\n\",","    \"        print(\\\"Status\\\", page.status_code, \\\":\\\", url)\\n\",","    \"        return None\\n\",","    \"    return BeautifulSoup(page.text, \\\"html.parser\\\")\"","   ]","  },","  {","   \"cell_type\": \"markdown\",","   \"id\": \"9b94caee\",","   \"metadata\": {},","   \"source\": [","    \"## 2. Street Parade\\n\",","    \"\\n\",","    \"**Attendance and cancellations** – official history page. Each edition starts with an `\x3Ch3>` year heading, followed by e.g. `850'000 Visitors`, or by `Abgesagt` (canceled).\"","   ]","  },","  {","   \"cell_type\": \"code\",","   \"execution_count\": 4,","   \"id\": \"11166c63\",","   \"metadata\": {},","   \"outputs\": [","    {","     \"name\": \"stdout\",","     \"output_type\": \"stream\",","     \"text\": [","      \"{2019: {'status': 'held', 'attendance': 850000}, 2020: {'status': 'canceled', 'attendance': None}, 2021: {'status': 'canceled', 'attendance': None}, 2022: {'status': 'held', 'attendance': 900000}, 2023: {'status': 'held', 'attendance': 920000}, 2024: {'status': 'held', 'attendance': 920000}, 2025: {'status': 'held', 'attendance': 800000}}\\n\"","     ]","    }","   ],","   \"source\": [","    \"sp_url = \\\"https://www.streetparade.com/en/historie\\\"\\n\",","    \"soup = get_page(sp_url)\\n\",","    \"\\n\",","    \"street_parade = {}\\n\",","    \"if soup is not None:\\n\",","    \"    for h3 in soup.find_all(\\\"h3\\\"):\\n\",","    \"        year = h3.getText(strip=True)\\n\",","    \"        if year not in [\\\"2019\\\", \\\"2020\\\", \\\"2021\\\", \\\"2022\\\", \\\"2023\\\", \\\"2024\\\", \\\"2025\\\"]:\\n\",","    \"            continue\\n\",","    \"        info = {\\\"status\\\": \\\"held\\\", \\\"attendance\\\": None}\\n\",","    \"        # read the texts after the heading until the next year heading starts\\n\",","    \"        for text in h3.find_all_next(string=True):\\n\",","    \"            if text.parent.name == \\\"h3\\\" and text.parent != h3:\\n\",","    \"                break\\n\",","    \"            if text.strip() == \\\"Abgesagt\\\":\\n\",","    \"                info[\\\"status\\\"] = \\\"canceled\\\"\\n\",","    \"            if text.strip().endswith(\\\"Visitors\\\"):\\n\",","    \"                info[\\\"attendance\\\"] = int(text.split()[0].replace(\\\"'\\\", \\\"\\\"))\\n\",","    \"        street_parade[int(year)] = info\\n\",","    \"\\n\",","    \"print(street_parade)\"","   ]","  },","  {","   \"cell_type\": \"markdown\",","   \"id\": \"1dd89a75\",","   \"metadata\": {},","   \"source\": [","    \"**Dates** are not on the history page.\\n\",","    \"\\n\",","    \"* 2019 – date tag of a City of Zürich police report published during the parade; the report states *Die Parade dauert zurzeit noch an* (the parade is still running)\\n\",","    \"* 2022–2025 – traffic notice of the Stadtpolizei Zürich, which states the date in one sentence:\\n\",","    \"  *Am Samstag, 13. August 2022, findet die Street Parade statt.*\\n\",","    \"  2022 is read from stadt-zuerich.ch; for 2023–2025 the City page could not be found,\\n\",","    \"  so verbatim copies on police news sites are used (they name the Stadtpolizei as source).\"","   ]","  },","  {","   \"cell_type\": \"code\",","   \"execution_count\": 5,","   \"id\": \"602dbfe0\",","   \"metadata\": {},","   \"outputs\": [","    {","     \"name\": \"stdout\",","     \"output_type\": \"stream\",","     \"text\": [","      \"2019 found: 2019-08-10 - report says: Die Parade dauert zurzeit noch an\\n\",","      \"2022 found: Am Samstag, 13. August 2022, findet die Street Parade\\n\",","      \"2023 found: Am Samstag, 12. August 2023, findet die Street Parade\\n\",","      \"2024 found: Am Samstag, 10. August 2024, findet die Street Parade\\n\",","      \"2025 found: Am Samstag, 9. August 2025, findet die Street Parade\\n\",","      \"{2019: ('2019-08-10', 'https://www.stadt-zuerich.ch/misc/de/mitteilungsarchiv/medienmitteilungen/2019/08/street_parade_2019zwischenbilanzderstadtpolizeizuerich.html'), 2022: ('2022-08-13', 'https://www.stadt-zuerich.ch/de/aktuell/medienmitteilungen/2022/08/220809a.html'), 2023: ('2023-08-12', 'https://polizei.news/2023/08/09/stadt-zuerich-zh-verkehrsvorschriften-street-parade-2023/'), 2024: ('2024-08-10', 'https://www.polizeinews.ch/2024/08/06/stadt-zuerich-zh-verkehrsvorschriften-street-parade-2024/'), 2025: ('2025-08-09', 'https://polizeiticker.ch/artikel/street-parade-2025-in-zuerich-sperrungen-und-umleitungen-im-stadtzentrum-246738')}\\n\"","     ]","    }","   ],","   \"source\": [","    \"sp_dates = {}   # year -> (date, source)\\n\",","    \"\\n\",","    \"url = \\\"https://www.stadt-zuerich.ch/misc/de/mitteilungsarchiv/medienmitteilungen/2019/08/street_parade_2019zwischenbilanzderstadtpolizeizuerich.html\\\"\\n\",","    \"soup = get_page(url)\\n\",","    \"if soup is not None:\\n\",","    \"    tag = soup.find(\\\"meta\\\", attrs={\\\"name\\\": \\\"date\\\"})\\n\",","    \"    text = \\\" \\\".join(soup.getText(\\\" \\\").split())\\n\",","    \"    # live police report: the parade was still running when it was published\\n\",","    \"    if tag is not None and \\\"Die Parade dauert zurzeit noch an\\\" in text:\\n\",","    \"        sp_dates[2019] = (tag[\\\"content\\\"][:10], url)\\n\",","    \"        print(2019, \\\"found:\\\", tag[\\\"content\\\"][:10], \\\"- report says: Die Parade dauert zurzeit noch an\\\")\\n\",","    \"    else:\\n\",","    \"        print(2019, \\\"date NOT confirmed on\\\", url)\\n\",","    \"\\n\",","    \"traffic_pages = {\\n\",","    \"    2022: \\\"https://www.stadt-zuerich.ch/de/aktuell/medienmitteilungen/2022/08/220809a.html\\\",\\n\",","    \"    2023: \\\"https://polizei.news/2023/08/09/stadt-zuerich-zh-verkehrsvorschriften-street-parade-2023/\\\",\\n\",","    \"    2024: \\\"https://www.polizeinews.ch/2024/08/06/stadt-zuerich-zh-verkehrsvorschriften-street-parade-2024/\\\",\\n\",","    \"    2025: \\\"https://polizeiticker.ch/artikel/street-parade-2025-in-zuerich-sperrungen-und-umleitungen-im-stadtzentrum-246738\\\",\\n\",","    \"}\\n\",","    \"\\n\",","    \"for year, url in traffic_pages.items():\\n\",","    \"    soup = get_page(url)\\n\",","    \"    if soup is None:\\n\",","    \"        continue\\n\",","    \"    text = \\\" \\\".join(soup.getText(\\\" \\\").split())   # also removes non-breaking spaces\\n\",","    \"    match = re.search(r\\\"Am Samstag, (\\\\d{1,2})\\\\. August \\\" + str(year) + \\\", findet die Street Parade\\\", text)\\n\",","    \"    if match:\\n\",","    \"        sp_dates[year] = (str(year) + \\\"-08-\\\" + match.group(1).zfill(2), url)\\n\",","    \"        print(year, \\\"found:\\\", match.group(0))\\n\",","    \"    else:\\n\",","    \"        print(year, \\\"date sentence NOT found on\\\", url)\\n\",","    \"\\n\",","    \"print(sp_dates)\"","   ]","  },","  {","   \"cell_type\": \"markdown\",","   \"id\": \"324124af\",","   \"metadata\": {},","   \"source\": [","    \"## 3. Züri Fäscht\\n\",","    \"\\n\",","    \"The official website (zuerifaescht.ch) does not allow scraping in its `robots.txt`, so other sources are used.\"","   ]","  },","  {","   \"cell_type\": \"markdown\",","   \"id\": \"cb12364d\",","   \"metadata\": {},","   \"source\": [","    \"Both date pages state the range in their `\x3Cmeta name=\\\"description\\\">` tag:\\n\",","    \"\\n\",","    \"* 2019 – Zürcher Handelskammer: *vom Freitag, 5. Juli bis Sonntag, 7. Juli 2019*\\n\",","    \"* 2023 – freizeit.ch: *vom 7. bis 9. Juli 2023*\"","   ]","  },","  {","   \"cell_type\": \"code\",","   \"execution_count\": 6,","   \"id\": \"9b7dcb45\",","   \"metadata\": {},","   \"outputs\": [],","   \"source\": [","    \"zf_pages = {\\n\",","    \"    2019: \\\"https://www.zhk.ch/de/wirtschaft-und-politik/mobilitaet-und-infrast